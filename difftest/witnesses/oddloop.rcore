read X9;
(* odd_store (proofs.v l.3851-3885): after the first two assignments
   (odd_store_reachable, l.3860) X1 = (nil.nil) = t and
   X0 = ((nil.nil).nil), which is neither t nor nil.
   Printed guards (X0 = t to enter), which proofs.v uses since
   2026-10-30 (loop_odd_store_stuck): stuck at loop entry.
   Before that, the guards tested X0 <> nil and X1 <> nil: the loop was
   entered and left at once and the program printed ((nil.nil).nil). *)
  X1 ^= =? X2 X3;
  X0 ^= cons X1 X4;
  from X0 loop X5 ^= nil until X1;
  X1 ^= =? X2 X3;
write X0
