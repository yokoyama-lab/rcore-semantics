read X0;
(* Inverse of oddloop.rcore (commands reversed, loop guards swapped).
   Input: ((nil.nil).nil), the forward output.
   Printed rules, which proofs.v uses since 2026-10-30: enter (X1 = t)
   but the exit test X0 = t fails and the iteration test X0 = nil fails
   too: stuck in mid-loop.  Before that, the guards tested <> nil: the
   loop was left at once and the program output nil. *)
  X1 ^= =? X2 X3;
  from X1 loop X5 ^= nil until X0;
  X0 ^= cons X1 X4;
  X1 ^= =? X2 X3;
write X9
